@model Portfolio.Core.DTOs.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Dashboard</h1>
        <p class="text-gray-600 mb-0">A quick overview of your portfolio activity.</p>
    </div>
    <div class="quick-actions">
        <a class="btn btn-primary btn-sm" href="@Url.Action("Create", "Projects", new { area = "Admin" })">
            <i class="fas fa-plus me-1"></i> New project
        </a>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Create", "Blog", new { area = "Admin" })">
            <i class="fas fa-pen me-1"></i> New post
        </a>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "SiteSettings", new { area = "Admin" })">
            <i class="fas fa-cog me-1"></i> Settings
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-left-primary h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-xs text-gray-600 text-uppercase mb-1">Total projects</div>
                    <div class="stat-value">@Model.TotalProjects</div>
                    <div class="text-gray-600 small mt-1">@Model.ActiveProjects active</div>
                </div>
                <div class="stat-icon"><i class="fas fa-project-diagram"></i></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-left-warning h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-xs text-gray-600 text-uppercase mb-1">Unread messages</div>
                    <div class="stat-value">@Model.UnreadMessages</div>
                    <div class="text-gray-600 small mt-1">Contact form inbox</div>
                </div>
                <div class="stat-icon"><i class="fas fa-envelope"></i></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-left-info h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-xs text-gray-600 text-uppercase mb-1">Views today</div>
                    <div class="stat-value">@Model.TodayPageViews</div>
                    <div class="text-gray-600 small mt-1">@Model.TotalPageViews total</div>
                </div>
                <div class="stat-icon"><i class="fas fa-eye"></i></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-left-success h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-xs text-gray-600 text-uppercase mb-1">Blog posts</div>
                    <div class="stat-value">@Model.TotalBlogPosts</div>
                    <div class="text-gray-600 small mt-1">Drafts and published</div>
                </div>
                <div class="stat-icon"><i class="fas fa-blog"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">Most popular projects</h2>
                <a class="small text-decoration-none" href="@Url.Action("Index", "Projects", new { area = "Admin" })">Manage</a>
            </div>
            <div class="card-body">
                @if (Model.TopProjects.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var project in Model.TopProjects)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>@project.ProjectTitle</span>
                                <span class="badge bg-primary rounded-pill">@project.ClickCount clicks</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-gray-600 mb-0">No project clicks recorded yet.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">Recent messages</h2>
                <a class="small text-decoration-none" href="@Url.Action("Index", "Messages", new { area = "Admin" })">Inbox</a>
            </div>
            <div class="card-body">
                @if (Model.RecentMessages.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var msg in Model.RecentMessages)
                        {
                            <li class="list-group-item px-0 @(!msg.IsRead ? "fw-semibold" : "")">
                                <div class="d-flex justify-content-between gap-3">
                                    <div class="text-truncate">
                                        <div class="text-truncate">@msg.Name</div>
                                        <div class="text-gray-600 small text-truncate">@msg.Email</div>
                                    </div>
                                    <div class="text-end flex-shrink-0">
                                        <div class="text-gray-600 small">@msg.ReceivedAt.ToString("MMM dd, HH:mm")</div>
                                        <a class="btn btn-sm btn-primary mt-1" href="@Url.Action("Details", "Messages", new { area = "Admin", id = msg.Id })">View</a>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-gray-600 mb-0">No messages yet.</p>
                }
            </div>
        </div>
    </div>
</div>

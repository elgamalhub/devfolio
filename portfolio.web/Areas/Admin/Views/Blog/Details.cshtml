@model Portfolio.Core.Entities.BlogPost
@{
    ViewData["Title"] = "Blog Post Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Blog Post Details</h1>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-blog"></i> @Model.TitleEn
                        @if (Model.IsPublished)
                        {
                            <span class="badge bg-success ms-2">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark ms-2">Draft</span>
                        }
                    </h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                    {
                        <div class="mb-4">
                            <img src="@Model.FeaturedImage" alt="@Model.TitleEn" class="img-fluid rounded" />
                        </div>
                    }

                    <dl class="row">
                        <dt class="col-sm-3">Title (EN):</dt>
                        <dd class="col-sm-9">@Model.TitleEn</dd>

                        <dt class="col-sm-3">Title (AR):</dt>
                        <dd class="col-sm-9" dir="rtl">@Model.TitleAr</dd>

                        <dt class="col-sm-3">Slug:</dt>
                        <dd class="col-sm-9"><code>@Model.Slug</code></dd>

                        <dt class="col-sm-3">Published:</dt>
                        <dd class="col-sm-9">@Model.PublishedAt.ToString("MMMM dd, yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Views:</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-info">@Model.ViewCount views</span>
                        </dd>

                        <dt class="col-sm-3">Tags:</dt>
                        <dd class="col-sm-9">
                            @foreach (var tag in Model.Tags)
                            {
                                <span class="badge bg-primary">@tag.TagName</span>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <h6>Content (English):</h6>
                    <div class="p-3 bg-light border rounded mb-3">
                        @Html.Raw(Model.ContentEn)
                    </div>

                    <h6>Content (Arabic):</h6>
                    <div class="p-3 bg-light border rounded" dir="rtl">
                        @Html.Raw(Model.ContentAr)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-info text-white">
                    <h6 class="m-0"><i class="fas fa-link"></i> Public Link</h6>
                </div>
                <div class="card-body">
                    <p>View this post on the public site:</p>
                    <a href="@Url.Action("Post", "Blog", new { slug = Model.Slug, area = "" })"
                       target="_blank" class="btn btn-primary btn-block">
                        <i class="fas fa-external-link-alt"></i> View Post
                    </a>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-warning">
                    <h6 class="m-0"><i class="fas fa-chart-line"></i> Statistics</h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li><strong>Total Views:</strong> @Model.ViewCount</li>
                        <li><strong>Tags Count:</strong> @Model.Tags.Count</li>
                        <li>
                            <strong>Status:</strong>
                            @if (Model.IsPublished)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Draft</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-danger text-white">
                    <h6 class="m-0"><i class="fas fa-trash"></i> Danger Zone</h6>
                </div>
                <div class="card-body">
                    <p class="text-muted">Delete this blog post permanently.</p>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Are you sure you want to delete this post?');">
                        <button type="submit" class="btn btn-danger btn-block w-100">
                            <i class="fas fa-trash"></i> Delete Post
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
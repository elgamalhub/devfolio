@using System.Text.RegularExpressions
@model IEnumerable<Portfolio.Core.Entities.BlogPost>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Blog";
    var lang = ViewBag.Language as string ?? "en";
    var allTags = ViewBag.AllTags as IEnumerable<string> ?? Enumerable.Empty<string>();
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentTag = ViewBag.CurrentTag as string;
    var readingTimes = ViewBag.ReadingTimes as Dictionary<int, int> ?? new Dictionary<int, int>();
    var posts = Model.ToList();
    var arrowIcon = lang == "ar" ? "fa-arrow-left" : "fa-arrow-right";
}

<div class="page-hero">
    <div class="container">
        <ul class="breadcrumbs">
            <li><a href="@Url.Action("Index", "Home", new { lang })">@(lang == "en" ? "Home" : "الرئيسية")</a></li>
            <li aria-current="page">@(lang == "en" ? "Blog" : "المدونة")</li>
        </ul>
        <h1>@(lang == "en" ? "Notes & Articles" : "مقالات وملاحظات")</h1>
        <p>@(lang == "en" ? "Practical writing on .NET, SQL Server, architecture, and building better web applications." : "كتابات عملية عن .NET وSQL Server والهندسة المعمارية وبناء تطبيقات ويب أفضل.")</p>
    </div>
</div>

<section class="blog-section">
    <div class="container">
        <div class="blog-toolbar">
            <form method="get" asp-action="Index" role="search">
                <input type="hidden" name="lang" value="@lang" />
                @if (!string.IsNullOrWhiteSpace(currentTag))
                {
                    <input type="hidden" name="tag" value="@currentTag" />
                }

                <div class="search-box">
                    <label class="visually-hidden" for="blogSearch">@(lang == "en" ? "Search articles" : "ابحث في المقالات")</label>
                    <input id="blogSearch" type="search" name="search" value="@currentSearch"
                           placeholder="@(lang == "en" ? "Search articles..." : "ابحث في المقالات...")" />
                    <button type="submit" aria-label="@(lang == "en" ? "Search" : "بحث")">
                        <i class="fas fa-search" aria-hidden="true"></i>
                    </button>
                </div>
            </form>

            @if (allTags.Any())
            {
                <div class="tag-filter">
                    <span class="tag-filter-label">@(lang == "en" ? "Topics:" : "المواضيع:")</span>
                    <a href="@Url.Action("Index", new { lang, search = currentSearch })"
                       class="tag-btn @(string.IsNullOrEmpty(currentTag) ? "active" : "")">
                        @(lang == "en" ? "All" : "الكل")
                    </a>
                    @foreach (var tag in allTags)
                    {
                        <a href="@Url.Action("Index", new { lang, search = currentSearch, tag })"
                           class="tag-btn @(currentTag == tag ? "active" : "")">#@tag</a>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(currentSearch) || !string.IsNullOrWhiteSpace(currentTag))
            {
                <div class="active-filters">
                    <strong>@(lang == "en" ? "Active filters:" : "الفلاتر النشطة:")</strong>

                    @if (!string.IsNullOrWhiteSpace(currentSearch))
                    {
                        <span class="active-filter-tag">
                            <i class="fas fa-search" aria-hidden="true"></i> @currentSearch
                            <a href="@Url.Action("Index", new { lang, tag = currentTag })"
                               aria-label="@(lang == "en" ? "Remove search filter" : "إزالة فلتر البحث")">
                                <i class="fas fa-times" aria-hidden="true"></i>
                            </a>
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(currentTag))
                    {
                        <span class="active-filter-tag">
                            <i class="fas fa-tag" aria-hidden="true"></i> @currentTag
                            <a href="@Url.Action("Index", new { lang, search = currentSearch })"
                               aria-label="@(lang == "en" ? "Remove tag filter" : "إزالة فلتر الوسم")">
                                <i class="fas fa-times" aria-hidden="true"></i>
                            </a>
                        </span>
                    }

                    <a href="@Url.Action("Index", new { lang })" class="btn btn-ghost">
                        @(lang == "en" ? "Clear all" : "مسح الكل")
                    </a>
                </div>
            }
        </div>

        @if (posts.Any())
        {
            <div class="row g-4">
                @foreach (var post in posts)
                {
                    var title = lang == "en" ? post.TitleEn : post.TitleAr;
                    var content = lang == "en" ? post.ContentEn : post.ContentAr;
                    var plainText = Regex.Replace(content, "<.*?>", " ");
                    plainText = Regex.Replace(plainText, @"\s+", " ").Trim();
                    var excerpt = plainText.Length > 150 ? plainText[..150].TrimEnd() + "…" : plainText;
                    var readMinutes = readingTimes.GetValueOrDefault(post.Id, 1);
                    var image = post.FeaturedImage;
                    var hasImage = !string.IsNullOrWhiteSpace(image)
                        && (image.StartsWith("/", StringComparison.Ordinal) || image.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                        && !image.Contains('\'');
                    var postUrl = Url.Action("Post", "Blog", new { slug = post.Slug, lang });

                    <div class="col-md-6 col-lg-4">
                        <article class="blog-card">
                            @if (hasImage)
                            {
                                <div class="blog-card-image" style="background-image:url('@image')" role="img" aria-label="@title"></div>
                            }
                            else
                            {
                                <div class="blog-placeholder-img">
                                    <i class="fas fa-pen-nib" aria-hidden="true"></i>
                                </div>
                            }

                            <div class="blog-card-body">
                                <div class="blog-meta">
                                    <span><i class="fas fa-calendar" aria-hidden="true"></i> @post.PublishedAt.ToString("MMM dd, yyyy")</span>
                                    <span><i class="fas fa-clock" aria-hidden="true"></i> @readMinutes @(lang == "en" ? "min read" : "دقيقة")</span>
                                    <span><i class="fas fa-eye" aria-hidden="true"></i> @post.ViewCount</span>
                                </div>

                                <h2 class="blog-card-title">
                                    <a href="@postUrl">@title</a>
                                </h2>

                                <p class="blog-card-excerpt">@excerpt</p>

                                @if (post.Tags.Any())
                                {
                                    <div class="blog-card-tags">
                                        @foreach (var tag in post.Tags.Take(3))
                                        {
                                            <a class="badge" href="@Url.Action("Index", new { lang, tag = tag.TagName })">#@tag.TagName</a>
                                        }
                                    </div>
                                }

                                <a href="@postUrl" class="btn btn-custom mt-auto">
                                    @(lang == "en" ? "Read article" : "اقرأ المقال")
                                    <i class="fas @arrowIcon" aria-hidden="true"></i>
                                </a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-results">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <h2>@(lang == "en" ? "No posts found" : "لم يتم العثور على مقالات")</h2>
                <p>@(lang == "en" ? "Try a different search term or clear the filters." : "جرّب كلمة بحث أخرى أو امسح الفلاتر.")</p>
                <a href="@Url.Action("Index", new { lang })" class="btn btn-custom">
                    @(lang == "en" ? "View all posts" : "عرض جميع المقالات")
                </a>
            </div>
        }
    </div>
</section>

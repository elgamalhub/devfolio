@model Portfolio.Core.DTOs.HomeViewModel
@{
    ViewData["Title"] = "Portfolio";
    ViewData["OgType"] = "profile";

    var lang = Model.CurrentLanguage;
    var settings = ViewBag.Settings as Dictionary<string, string> ?? new Dictionary<string, string>();
    var sections = ViewBag.Sections as List<Portfolio.Core.Entities.Section> ?? new List<Portfolio.Core.Entities.Section>();
    var hasCertificateSection = sections.Any(s => s.IsVisible && string.Equals(s.Identifier, "certificates", StringComparison.OrdinalIgnoreCase));
    var description = lang == "ar"
        ? settings.GetValueOrDefault("meta_description_ar", "مطور .NET متكامل يبني تطبيقات ويب احترافية وآمنة.")
        : settings.GetValueOrDefault("meta_description_en", "Full Stack .NET developer building secure, polished web applications.");

    ViewData["Description"] = description;
    ViewData["OgImage"] = Model.About?.ProfileImage;

    var certificatesRendered = false;
}

@foreach (var sec in sections)
{
    <section id="@sec.Identifier">
        @if (sec.Identifier == "home")
        {
            @await Html.PartialAsync("_HeroSection", Model)
        }
        else if (sec.Identifier == "about")
        {
            @await Html.PartialAsync("_AboutSection", Model)
        }
        else if (sec.Identifier == "experience")
        {
            @await Html.PartialAsync("_ExperienceSection", Model)
        }
        else if (sec.Identifier == "skills")
        {
            @await Html.PartialAsync("_SkillsSection", Model)
        }
        else if (sec.Identifier == "projects")
        {
            @await Html.PartialAsync("_ProjectsSection", Model)
        }
        else if (sec.Identifier == "certificates")
        {
            @await Html.PartialAsync("_CertificatesSection", Model)
            certificatesRendered = true;
        }
        else if (sec.Identifier == "blog" && ViewBag.RecentPosts != null)
        {
            @await Html.PartialAsync("_RecentBlogSection", Model)
        }
        else if (sec.Identifier == "testimonials" && Model.Testimonials.Any())
        {
            @await Html.PartialAsync("_TestimonialsSection", Model)
        }
        else if (sec.Identifier == "contact")
        {
            @await Html.PartialAsync("_ContactSection", Model)
        }
        else if (!sec.IsBuiltIn)
        {
            <div class="container">
                <h2 class="section-title">@(lang == "en" ? sec.NameEn : sec.NameAr)</h2>
                <div class="custom-section-content">
                    @Html.Raw(sec.CustomContent ?? $"<p>Custom section: {sec.NameEn}</p>")
                </div>
            </div>
        }
    </section>

    @if (string.Equals(sec.Identifier, "skills", StringComparison.OrdinalIgnoreCase) && !hasCertificateSection && Model.Certificates.Any())
    {
        <section id="certificates">
            @await Html.PartialAsync("_CertificatesSection", Model)
        </section>
        certificatesRendered = true;
    }
}

@if (!certificatesRendered && Model.Certificates.Any())
{
    <section id="certificates">
        @await Html.PartialAsync("_CertificatesSection", Model)
    </section>
}

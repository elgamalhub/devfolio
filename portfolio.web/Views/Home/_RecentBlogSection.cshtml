@model Portfolio.Core.DTOs.HomeViewModel
@{
    var lang = Model.CurrentLanguage;
    var recentPosts = ViewBag.RecentPosts as List<Portfolio.Core.Entities.BlogPost> ?? new List<Portfolio.Core.Entities.BlogPost>();
}

@if (recentPosts.Any())
{
    <div class="container">
        <h2 class="section-title">@(lang == "en" ? "From the Blog" : "من المدونة")</h2>
        <p class="section-subtitle">@(lang == "en" ? "Notes on .NET, architecture, and the craft of building software." : "ملاحظات عن .NET والهندسة المعمارية وفن بناء البرمجيات.")</p>

        <div class="row g-4">
            @foreach (var post in recentPosts.Take(3))
            {
                var title = lang == "en" ? post.TitleEn : post.TitleAr;
                var content = lang == "en" ? post.ContentEn : post.ContentAr;
                var plainText = System.Text.RegularExpressions.Regex.Replace(content, "<.*?>", " ");
                var excerpt = plainText.Length > 120 ? plainText[..120].TrimEnd() + "…" : plainText.Trim();
                var words = plainText.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
                var readMinutes = Math.Max(1, (int)Math.Ceiling(words / 200.0));
                var image = post.FeaturedImage;
                var hasImage = !string.IsNullOrWhiteSpace(image)
                    && (image.StartsWith("/", StringComparison.Ordinal) || image.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                    && !image.Contains('\'');

                <div class="col-md-6 col-lg-4">
                    <article class="blog-preview-card">
                        @if (hasImage)
                        {
                            <div class="blog-preview-image" style="background-image:url('@image')" role="img" aria-label="@title"></div>
                        }
                        else
                        {
                            <div class="blog-preview-image"></div>
                        }

                        <div class="blog-preview-content">
                            <div class="blog-preview-meta">
                                <span><i class="fas fa-calendar" aria-hidden="true"></i> @post.PublishedAt.ToString("MMM dd, yyyy")</span>
                                <span><i class="fas fa-clock" aria-hidden="true"></i> @readMinutes @(lang == "en" ? "min" : "د")</span>
                                <span><i class="fas fa-eye" aria-hidden="true"></i> @post.ViewCount</span>
                            </div>

                            <h3 class="blog-preview-title">@title</h3>
                            <p class="blog-preview-excerpt">@excerpt</p>

                            @if (post.Tags.Any())
                            {
                                <div class="blog-preview-tags">
                                    @foreach (var tag in post.Tags.Take(2))
                                    {
                                        <a class="blog-tag" href="@Url.Action("Index", "Blog", new { lang, tag = tag.TagName })">#@tag.TagName</a>
                                    }
                                </div>
                            }

                            <a href="@Url.Action("Post", "Blog", new { slug = post.Slug, lang })" class="btn btn-custom">
                                @(lang == "en" ? "Read article" : "اقرأ المقال")
                                <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a href="@Url.Action("Index", "Blog", new { lang })" class="btn btn-custom-outline">
                <i class="fas fa-blog me-2" aria-hidden="true"></i>
                @(lang == "en" ? "View all posts" : "عرض جميع المقالات")
            </a>
        </div>
    </div>
}

@model Portfolio.Core.DTOs.HomeViewModel
@{
    var lang = Model.CurrentLanguage;
}

<div class="container">
    <h2 class="section-title">@(lang == "en" ? "What Clients Say" : "آراء العملاء")</h2>
    <p class="text-center text-muted mb-5">@(lang == "en" ? "Don't just take my word for it" : "لا تأخذ كلامي فقط")</p>

    <div class="row g-4">
        @foreach (var testimonial in Model.Testimonials)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="testimonial-card-enhanced">
                    <div class="testimonial-quote">
                        <i class="fas fa-quote-left"></i>
                    </div>

                    <div class="testimonial-rating mb-3">
                        @for (int i = 0; i < testimonial.Rating; i++)
                        {
                            <i class="fas fa-star"></i>
                        }
                        @for (int i = testimonial.Rating; i < 5; i++)
                        {
                            <i class="far fa-star"></i>
                        }
                    </div>

                    <p class="testimonial-text-enhanced">
                        "@(lang == "en" ? testimonial.TestimonialTextEn : testimonial.TestimonialTextAr)"
                    </p>

                    <div class="testimonial-author">
                        @if (!string.IsNullOrEmpty(testimonial.ClientImage))
                        {
                            <img src="@testimonial.ClientImage" alt="@testimonial.ClientName" class="author-image" />
                        }
                        else
                        {
                            <div class="author-image-placeholder">
                                <i class="fas fa-user"></i>
                            </div>
                        }
                        <div class="author-info">
                            <h5 class="author-name">@testimonial.ClientName</h5>
                            <p class="author-position">
                                @testimonial.Position
                                @if (!string.IsNullOrEmpty(testimonial.Company))
                                {
                                    <span>at @testimonial.Company</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .testimonial-card-enhanced {
        background: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        position: relative;
        height: 100%;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .testimonial-card-enhanced:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        }

    .testimonial-quote {
        position: absolute;
        top: 20px;
        right: 20px;
        font-size: 3rem;
        color: rgba(102, 126, 234, 0.1);
    }

    .testimonial-rating {
        color: #ffc107;
        font-size: 1.2rem;
    }

    .testimonial-text-enhanced {
        font-size: 1rem;
        line-height: 1.8;
        color: #555;
        margin: 20px 0;
        font-style: italic;
    }

    .testimonial-author {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 2px solid #f0f0f0;
    }

    .author-image {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #667eea;
    }

    .author-image-placeholder {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
    }

    .author-info {
        flex: 1;
    }

    .author-name {
        font-size: 1.1rem;
        font-weight: bold;
        margin: 0;
        color: #333;
    }

    .author-position {
        font-size: 0.9rem;
        color: #777;
        margin: 0;
    }

    body.light-mode .testimonial-card-enhanced {
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    body.light-mode .testimonial-text-enhanced {
        color: #555;
    }
</style>
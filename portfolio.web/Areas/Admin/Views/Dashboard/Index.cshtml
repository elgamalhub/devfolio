@model Portfolio.Core.DTOs.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Dashboard</h1>

    <!-- Stats Cards -->
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Projects</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalProjects</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-project-diagram fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Active Projects</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.ActiveProjects</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Unread Messages</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.UnreadMessages</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-envelope fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Page Views (Today)</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TodayPageViews</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-eye fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Top Projects -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Most Popular Projects</h6>
                </div>
                <div class="card-body">
                    @if (Model.TopProjects.Any())
                    {
                        <ul class="list-group">
                            @foreach (var project in Model.TopProjects)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @project.ProjectTitle
                                    <span class="badge badge-primary badge-pill">@project.ClickCount clicks</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No project clicks yet.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Messages -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Recent Messages</h6>
                </div>
                <div class="card-body">
                    @if (Model.RecentMessages.Any())
                    {
                        <ul class="list-group">
                            @foreach (var msg in Model.RecentMessages)
                            {
                                <li class="list-group-item @(!msg.IsRead ? "font-weight-bold" : "")">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>@msg.Name</strong> - @msg.Email
                                        </div>
                                        <small class="text-muted">@msg.ReceivedAt.ToString("MMM dd, HH:mm")</small>
                                    </div>
                                    <a href="@Url.Action("Details", "Messages", new { id = msg.Id })" class="btn btn-sm btn-primary mt-2">View</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No messages yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@model Portfolio.Core.DTOs.HomeViewModel
@{
    var lang = Model.CurrentLanguage;
    var settings = ViewBag.Settings as Dictionary<string, string> ?? new Dictionary<string, string>();
    var heroImage = settings.GetValueOrDefault("hero_background_image", "");
    var hasHeroImage = !string.IsNullOrWhiteSpace(heroImage)
        && (heroImage.StartsWith("/", StringComparison.Ordinal) || heroImage.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        && !heroImage.Contains('\'')
        && !heroImage.Contains('(');

    var name = lang == "en" ? Model.About?.NameEn : Model.About?.NameAr;
    var location = Model.About?.Location;
    var availability = lang == "en" ? "Open to opportunities" : "متاح لفرص العمل";
}

<div class="hero @(hasHeroImage ? "has-image" : "")"
     style="@(hasHeroImage ? $"background-image:url('{heroImage}');" : "")">
    <div class="hero-content">
        <span class="hero-eyebrow">
            <span class="status-dot" aria-hidden="true"></span>
            @availability
        </span>

        <h1>@(lang == "en" ? $"Hi, I'm {name}" : $"مرحباً، أنا {name}")</h1>

        <p class="tagline">
            <span class="typing-text" id="typingText" aria-live="polite"></span>
        </p>

        <div class="hero-buttons">
            <a class="btn btn-custom" href="#contact">
                @(lang == "en" ? "Get in touch" : "تواصل معي")
                <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </a>
            @if (!string.IsNullOrWhiteSpace(Model.About?.CVFilePath))
            {
                <a href="@Model.About.CVFilePath" download class="btn btn-custom-outline">
                    <i class="fas fa-download" aria-hidden="true"></i>
                    @(lang == "en" ? "Download CV" : "تحميل السيرة الذاتية")
                </a>
            }
        </div>

        @if (Model.SocialLinks.Any())
        {
            <div class="hero-socials">
                @foreach (var link in Model.SocialLinks)
                {
                    <a class="social-icon" href="@link.Url" target="_blank" rel="noopener noreferrer"
                       title="@link.Platform" aria-label="@link.Platform">
                        <i class="@link.IconClass" aria-hidden="true"></i>
                    </a>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(location))
    {
        <a class="hero-scroll" href="#about" aria-label="@(lang == "en" ? "Scroll to about section" : "انتقل إلى قسم عني")">
            <span>@location</span>
            <i class="fas fa-chevron-down" aria-hidden="true"></i>
        </a>
    }
</div>

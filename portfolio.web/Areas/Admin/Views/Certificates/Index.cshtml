@model IEnumerable<Portfolio.Core.Entities.Certificate>
@{
    ViewData["Title"] = "Certificates";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var certificates = Model.ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Certificates</h1>
        <p class="text-gray-600 mb-0">Programs, courses and credentials shown on the public site.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Add certificate
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (certificates.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Badge</th>
                            <th>Name</th>
                            <th>Issuer</th>
                            <th>Issue date</th>
                            <th>Order</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var certificate in certificates)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(certificate.BadgeImage))
                                    {
                                        <img src="@certificate.BadgeImage" alt="@certificate.NameEn" class="table-thumb" />
                                    }
                                    else
                                    {
                                        <span class="stat-icon"><i class="fas fa-certificate"></i></span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@certificate.NameEn</div>
                                    <div class="text-gray-600 small" dir="rtl">@certificate.NameAr</div>
                                </td>
                                <td>@certificate.Issuer</td>
                                <td>@certificate.IssueDate.ToString("MMM yyyy")</td>
                                <td>@certificate.Order</td>
                                <td>
                                    @if (certificate.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Hidden</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@certificate.Id" class="btn btn-sm btn-outline-warning" title="Edit certificate">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@certificate.Id" method="post" class="d-inline"
                                          data-confirm="Delete this certificate? This cannot be undone.">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete certificate">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="stat-icon mx-auto mb-3"><i class="fas fa-certificate"></i></div>
                <h2 class="h5">No certificates yet</h2>
                <p class="text-gray-600">Add your first credential to display it on the home page.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i> Add certificate
                </a>
            </div>
        }
    </div>
</div>

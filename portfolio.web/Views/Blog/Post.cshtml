@model Portfolio.Core.Entities.BlogPost
@{
    var lang = ViewBag.Language as string ?? "en";
    var title = lang == "en" ? Model.TitleEn : Model.TitleAr;
    var readMinutes = ViewBag.ReadingTime is int minutes ? minutes : 1;
    var relatedPosts = ViewBag.RelatedPosts as List<Portfolio.Core.Entities.BlogPost> ?? new List<Portfolio.Core.Entities.BlogPost>();

    ViewData["Title"] = title;

    var image = Model.FeaturedImage;
    var hasImage = !string.IsNullOrWhiteSpace(image)
        && (image.StartsWith("/", StringComparison.Ordinal) || image.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        && !image.Contains('\'');

    var absoluteUrl = Url.Action("Post", "Blog", new { slug = Model.Slug, lang }, Context.Request.Scheme) ?? string.Empty;
    var encodedUrl = Uri.EscapeDataString(absoluteUrl);
    var encodedTitle = Uri.EscapeDataString(title);

    var facebookUrl = $"https://www.facebook.com/sharer/sharer.php?u={encodedUrl}";
    var twitterUrl = $"https://twitter.com/intent/tweet?url={encodedUrl}&text={encodedTitle}";
    var linkedinUrl = $"https://www.linkedin.com/sharing/share-offsite/?url={encodedUrl}";
    var whatsappUrl = $"https://wa.me/?text={Uri.EscapeDataString($"{title} {absoluteUrl}")}";
    var arrowIcon = lang == "ar" ? "fa-arrow-left" : "fa-arrow-right";
}

<div class="post-container">
    <div class="container">
        <ul class="breadcrumbs mb-4">
            <li><a href="@Url.Action("Index", "Home", new { lang })">@(lang == "en" ? "Home" : "الرئيسية")</a></li>
            <li><a href="@Url.Action("Index", "Blog", new { lang })">@(lang == "en" ? "Blog" : "المدونة")</a></li>
            <li aria-current="page">@title</li>
        </ul>

        <article class="post-card">
            <header class="post-header @(hasImage ? "" : "post-header-gradient")"
                    style="@(hasImage ? $"background-image:url('{image}');" : "")">
                <div class="post-header-inner">
                    <h1>@title</h1>
                    <div class="post-meta">
                        <span class="post-meta-item">
                            <i class="fas fa-calendar" aria-hidden="true"></i>
                            <time datetime="@Model.PublishedAt.ToString("yyyy-MM-dd")">@Model.PublishedAt.ToString("MMMM dd, yyyy")</time>
                        </span>
                        <span class="post-meta-item">
                            <i class="fas fa-clock" aria-hidden="true"></i>
                            @readMinutes @(lang == "en" ? "min read" : "دقيقة قراءة")
                        </span>
                        <span class="post-meta-item">
                            <i class="fas fa-eye" aria-hidden="true"></i>
                            @Model.ViewCount @(lang == "en" ? "views" : "مشاهدة")
                        </span>
                    </div>
                </div>
            </header>

            <div class="post-body">
                @if (Model.Tags.Any())
                {
                    <div class="post-tags">
                        @foreach (var tag in Model.Tags)
                        {
                            <a class="post-tag" href="@Url.Action("Index", "Blog", new { lang, tag = tag.TagName })">
                                <i class="fas fa-tag" aria-hidden="true"></i> @tag.TagName
                            </a>
                        }
                    </div>
                }

                <div class="post-content">
                    @Html.Raw(lang == "en" ? Model.ContentEn : Model.ContentAr)
                </div>
            </div>

            <footer class="post-footer">
                <h2 class="h5 mb-0">@(lang == "en" ? "Share this article" : "شارك هذا المقال")</h2>

                <div class="share-buttons">
                    <a class="share-btn facebook" href="@facebookUrl" target="_blank" rel="noopener noreferrer"
                       aria-label="@(lang == "en" ? "Share on Facebook" : "شارك على فيسبوك")">
                        <i class="fab fa-facebook-f" aria-hidden="true"></i>
                    </a>
                    <a class="share-btn twitter" href="@twitterUrl" target="_blank" rel="noopener noreferrer"
                       aria-label="@(lang == "en" ? "Share on X" : "شارك على X")">
                        <i class="fab fa-x-twitter" aria-hidden="true"></i>
                    </a>
                    <a class="share-btn linkedin" href="@linkedinUrl" target="_blank" rel="noopener noreferrer"
                       aria-label="@(lang == "en" ? "Share on LinkedIn" : "شارك على لينكدإن")">
                        <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                    </a>
                    <a class="share-btn whatsapp" href="@whatsappUrl" target="_blank" rel="noopener noreferrer"
                       aria-label="@(lang == "en" ? "Share on WhatsApp" : "شارك على واتساب")">
                        <i class="fab fa-whatsapp" aria-hidden="true"></i>
                    </a>
                    <button class="share-btn copy" type="button" data-copy-url="@absoluteUrl"
                            aria-label="@(lang == "en" ? "Copy article link" : "نسخ رابط المقال")">
                        <i class="fas fa-link" aria-hidden="true"></i>
                    </button>
                </div>
            </footer>
        </article>

        <div class="text-center mt-4">
            <a href="@Url.Action("Index", "Blog", new { lang })" class="btn btn-custom-outline">
                <i class="fas @arrowIcon" aria-hidden="true"></i>
                @(lang == "en" ? "Back to all articles" : "العودة إلى جميع المقالات")
            </a>
        </div>

        @if (relatedPosts.Any())
        {
            <section class="related-posts">
                <h2>@(lang == "en" ? "Related articles" : "مقالات ذات صلة")</h2>

                <div class="related-grid">
                    @foreach (var related in relatedPosts)
                    {
                        var relatedTitle = lang == "en" ? related.TitleEn : related.TitleAr;
                        var relatedImage = related.FeaturedImage;
                        var relatedHasImage = !string.IsNullOrWhiteSpace(relatedImage)
                            && (relatedImage.StartsWith("/", StringComparison.Ordinal) || relatedImage.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                            && !relatedImage.Contains('\'');

                        <article class="related-card">
                            @if (relatedHasImage)
                            {
                                <div class="related-card-image" style="background-image:url('@relatedImage')" role="img" aria-label="@relatedTitle"></div>
                            }
                            else
                            {
                                <div class="related-card-image"></div>
                            }

                            <div class="related-card-body">
                                <h3>
                                    <a href="@Url.Action("Post", "Blog", new { slug = related.Slug, lang })">@relatedTitle</a>
                                </h3>
                                <span class="related-card-date">
                                    <i class="fas fa-calendar me-1" aria-hidden="true"></i>
                                    @related.PublishedAt.ToString("MMM dd, yyyy")
                                </span>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
</div>

@model IEnumerable<Portfolio.Core.Entities.SiteSettings>
@{
    ViewData["Title"] = "Site Settings";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var settings = Model.ToList();
    var sections = (ViewBag.Sections as IEnumerable<Portfolio.Core.Entities.Section>)?.ToList()
                   ?? new List<Portfolio.Core.Entities.Section>();

    Portfolio.Core.Entities.SiteSettings? Get(string key) =>
        settings.FirstOrDefault(s => string.Equals(s.Key, key, StringComparison.OrdinalIgnoreCase));

    string Img(string key) => Get(key)?.ValueEn ?? string.Empty;

    string LabelFor(string key)
    {
        var language = key.EndsWith("_ar", StringComparison.OrdinalIgnoreCase)
            ? " (Arabic)"
            : key.EndsWith("_en", StringComparison.OrdinalIgnoreCase)
                ? " (English)"
                : string.Empty;

        var baseKey = key.EndsWith("_ar", StringComparison.OrdinalIgnoreCase)
            ? key[..^3]
            : key.EndsWith("_en", StringComparison.OrdinalIgnoreCase)
                ? key[..^3]
                : key;

        return string.Join(' ', baseKey.Split('_', StringSplitOptions.RemoveEmptyEntries))
            .ToUpperInvariant() + language;
    }

    var generalSettings = settings
        .Where(s => !s.Key.StartsWith("preloader_", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(s.DataType, "file", StringComparison.OrdinalIgnoreCase))
        .ToList();

    var preloaderSettings = settings
        .Where(s => s.Key.StartsWith("preloader_", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(s.DataType, "file", StringComparison.OrdinalIgnoreCase))
        .ToList();

    var heroImage = Img("hero_background_image");
    var preloaderLogo = Img("preloader_logo");
    var preloaderBackgroundImage = Img("preloader_background_image");
    var ogImage = Img("og_image");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Site Settings</h1>
        <p class="text-gray-600 mb-0">Control the public content, appearance and section order.</p>
    </div>
    <form asp-action="ResetToDefaults" method="post" data-confirm="Restore all settings to their default values?">
        <button type="submit" class="btn btn-outline-warning btn-sm">
            <i class="fas fa-undo me-1"></i> Reset to defaults
        </button>
    </form>
</div>

<div class="row g-3">
    <div class="col-xl-7">
        <div class="card mb-3">
            <div class="card-header">
                <h2 class="h6 mb-0"><i class="fas fa-cog me-2 text-primary"></i>General settings</h2>
            </div>
            <div class="card-body">
                <form asp-action="UpdateSettings" method="post">
                    @foreach (var setting in generalSettings)
                    {
                        var isArabic = setting.Key.EndsWith("_ar", StringComparison.OrdinalIgnoreCase);
                        var isEnglish = setting.Key.EndsWith("_en", StringComparison.OrdinalIgnoreCase);
                        var isTranslatable = setting.DataType == "text" || setting.DataType == "textarea";
                        var isPaired = isTranslatable && !isArabic && !isEnglish;

                        <div class="mb-3">
                            <label class="form-label" for="en-@setting.Key">@LabelFor(setting.Key)</label>
                            @if (!string.IsNullOrWhiteSpace(setting.Description))
                            {
                                <span class="input-hint">@setting.Description</span>
                            }

                            @if (setting.DataType == "boolean")
                            {
                                <select id="en-@setting.Key" name="en[@setting.Key]" class="form-select">
                                    <option value="true" selected="@(setting.ValueEn == "true")">Enabled</option>
                                    <option value="false" selected="@(setting.ValueEn == "false")">Disabled</option>
                                </select>
                            }
                            else if (setting.DataType == "color")
                            {
                                <input id="en-@setting.Key" type="color" name="en[@setting.Key]"
                                       class="form-control form-control-color" value="@setting.ValueEn" />
                            }
                            else if (setting.DataType == "select")
                            {
                                <select id="en-@setting.Key" name="en[@setting.Key]" class="form-select">
                                    @if (setting.Key == "default_language")
                                    {
                                        <option value="en" selected="@(setting.ValueEn == "en")">English</option>
                                        <option value="ar" selected="@(setting.ValueEn == "ar")">Arabic</option>
                                    }
                                    else if (setting.Key == "default_theme")
                                    {
                                        <option value="dark" selected="@(setting.ValueEn == "dark")">Dark</option>
                                        <option value="light" selected="@(setting.ValueEn == "light")">Light</option>
                                    }
                                    else
                                    {
                                        <option value="@setting.ValueEn" selected>@setting.ValueEn</option>
                                    }
                                </select>
                            }
                            else if (setting.DataType == "number")
                            {
                                <input id="en-@setting.Key" type="number" name="en[@setting.Key]"
                                       class="form-control" value="@setting.ValueEn" />
                            }
                            else if (setting.DataType == "textarea")
                            {
                                <textarea id="en-@setting.Key" name="en[@setting.Key]" rows="3"
                                          class="form-control" dir="@(isArabic ? "rtl" : "ltr")">@setting.ValueEn</textarea>
                            }
                            else
                            {
                                <input id="en-@setting.Key" type="text" name="en[@setting.Key]"
                                       class="form-control" value="@setting.ValueEn"
                                       dir="@(isArabic ? "rtl" : "ltr")" />
                            }

                            @if (isPaired)
                            {
                                <label class="form-label mt-2" for="ar-@setting.Key">@LabelFor(setting.Key + "_ar")</label>
                                <textarea id="ar-@setting.Key" name="ar[@setting.Key]" rows="3"
                                          class="form-control" dir="rtl">@setting.ValueAr</textarea>
                            }
                        </div>
                    }

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Save general settings
                    </button>
                </form>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h2 class="h6 mb-0"><i class="fas fa-spinner me-2 text-primary"></i>Preloader</h2>
            </div>
            <div class="card-body">
                @if (preloaderSettings.Any())
                {
                    <form asp-action="UpdateSettings" method="post">
                        @foreach (var setting in preloaderSettings)
                        {
                            <div class="mb-3">
                                <label class="form-label" for="pre-@setting.Key">@LabelFor(setting.Key)</label>
                                @if (!string.IsNullOrWhiteSpace(setting.Description))
                                {
                                    <span class="input-hint">@setting.Description</span>
                                }

                                @if (setting.Key == "preloader_style")
                                {
                                    <select id="pre-@setting.Key" name="en[@setting.Key]" class="form-select">
                                        <option value="spinner" selected="@(setting.ValueEn == "spinner")">Classic spinner</option>
                                        <option value="dots" selected="@(setting.ValueEn == "dots")">Bouncing dots</option>
                                        <option value="pulse" selected="@(setting.ValueEn == "pulse")">Pulse circle</option>
                                        <option value="bars" selected="@(setting.ValueEn == "bars")">Wave bars</option>
                                        <option value="circle" selected="@(setting.ValueEn == "circle")">Circle loader</option>
                                        <option value="logo" selected="@(setting.ValueEn == "logo")">Custom logo</option>
                                    </select>
                                }
                                else if (setting.Key == "preloader_background")
                                {
                                    <select id="pre-@setting.Key" name="en[@setting.Key]" class="form-select">
                                        <option value="gradient" selected="@(setting.ValueEn == "gradient")">Gradient</option>
                                        <option value="solid" selected="@(setting.ValueEn == "solid")">Solid colour</option>
                                        <option value="image" selected="@(setting.ValueEn == "image")">Custom image</option>
                                    </select>
                                }
                                else if (setting.DataType == "boolean")
                                {
                                    <select id="pre-@setting.Key" name="en[@setting.Key]" class="form-select">
                                        <option value="true" selected="@(setting.ValueEn == "true")">Enabled</option>
                                        <option value="false" selected="@(setting.ValueEn == "false")">Disabled</option>
                                    </select>
                                }
                                else if (setting.DataType == "color")
                                {
                                    <input id="pre-@setting.Key" type="color" name="en[@setting.Key]"
                                           class="form-control form-control-color" value="@setting.ValueEn" />
                                }
                                else if (setting.DataType == "number")
                                {
                                    <input id="pre-@setting.Key" type="number" name="en[@setting.Key]"
                                           class="form-control" value="@setting.ValueEn" min="0" max="10000" step="100" />
                                }
                                else
                                {
                                    <input id="pre-@setting.Key" type="text" name="en[@setting.Key]"
                                           class="form-control" value="@setting.ValueEn" />
                                }
                            </div>
                        }

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Save preloader settings
                        </button>
                    </form>
                }
                else
                {
                    <p class="text-gray-600 mb-0">No preloader settings are configured.</p>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h2 class="h6 mb-0"><i class="fas fa-image me-2 text-primary"></i>Images</h2>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h3 class="h6">Hero background</h3>
                    @if (!string.IsNullOrWhiteSpace(heroImage))
                    {
                        <img src="@heroImage" alt="Current hero background" class="img-fluid rounded mb-2" style="max-height: 180px;" />
                        <form asp-action="RemoveHeroImage" method="post" class="mb-2" data-confirm="Remove the hero background image?">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-trash me-1"></i> Remove image
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="text-gray-600">No background image is set; the gradient is used.</p>
                    }
                    <form asp-action="UploadHeroImage" method="post" enctype="multipart/form-data">
                        <label class="form-label" for="heroImage">Upload new background</label>
                        <input id="heroImage" type="file" name="heroImage" class="form-control"
                               accept="image/*" data-preview="#heroPreview" required />
                        <span class="input-hint">Recommended size: 1920 x 1080 pixels.</span>
                        <img id="heroPreview" class="image-preview" alt="Selected hero background preview" />
                        <button type="submit" class="btn btn-primary btn-sm mt-2">
                            <i class="fas fa-upload me-1"></i> Upload
                        </button>
                    </form>
                </div>

                <hr />

                <div class="mb-4">
                    <h3 class="h6">Preloader logo</h3>
                    @if (!string.IsNullOrWhiteSpace(preloaderLogo))
                    {
                        <img src="@preloaderLogo" alt="Current preloader logo" class="img-fluid rounded mb-2" style="max-height: 90px;" />
                        <form asp-action="RemovePreloaderLogo" method="post" class="mb-2" data-confirm="Remove the preloader logo?">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-trash me-1"></i> Remove logo
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="text-gray-600">No custom logo is set.</p>
                    }
                    <form asp-action="UploadPreloaderLogo" method="post" enctype="multipart/form-data">
                        <label class="form-label" for="preloaderLogo">Upload logo</label>
                        <input id="preloaderLogo" type="file" name="preloaderLogo" class="form-control"
                               accept="image/*" data-preview="#logoPreview" required />
                        <img id="logoPreview" class="image-preview" alt="Selected preloader logo preview" />
                        <button type="submit" class="btn btn-primary btn-sm mt-2">
                            <i class="fas fa-upload me-1"></i> Upload
                        </button>
                    </form>
                </div>

                <hr />

                <div class="mb-4">
                    <h3 class="h6">Preloader background image</h3>
                    @if (!string.IsNullOrWhiteSpace(preloaderBackgroundImage))
                    {
                        <img src="@preloaderBackgroundImage" alt="Current preloader background" class="img-fluid rounded mb-2" style="max-height: 150px;" />
                        <form asp-action="RemovePreloaderBackgroundImage" method="post" class="mb-2" data-confirm="Remove the preloader background image?">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-trash me-1"></i> Remove background
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="text-gray-600">No preloader background image is set.</p>
                    }
                    <form asp-action="UploadPreloaderBackgroundImage" method="post" enctype="multipart/form-data">
                        <label class="form-label" for="backgroundImage">Upload background</label>
                        <input id="backgroundImage" type="file" name="backgroundImage" class="form-control"
                               accept="image/*" data-preview="#preloaderBackgroundPreview" required />
                        <img id="preloaderBackgroundPreview" class="image-preview" alt="Selected preloader background preview" />
                        <button type="submit" class="btn btn-primary btn-sm mt-2">
                            <i class="fas fa-upload me-1"></i> Upload
                        </button>
                    </form>
                </div>

                <hr />

                <div>
                    <h3 class="h6">Social sharing image</h3>
                    @if (!string.IsNullOrWhiteSpace(ogImage))
                    {
                        <img src="@ogImage" alt="Current social sharing image" class="img-fluid rounded mb-2" style="max-height: 150px;" />
                        <form asp-action="RemoveOgImage" method="post" class="mb-2" data-confirm="Remove the social sharing image?">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-trash me-1"></i> Remove image
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="text-gray-600">No Open Graph image is set.</p>
                    }
                    <form asp-action="UploadOgImage" method="post" enctype="multipart/form-data">
                        <label class="form-label" for="ogImage">Upload social sharing image</label>
                        <input id="ogImage" type="file" name="ogImage" class="form-control"
                               accept="image/*" data-preview="#ogPreview" required />
                        <span class="input-hint">Used when the site is shared on social networks. 1200 x 630 pixels works best.</span>
                        <img id="ogPreview" class="image-preview" alt="Selected social sharing image preview" />
                        <button type="submit" class="btn btn-primary btn-sm mt-2">
                            <i class="fas fa-upload me-1"></i> Upload
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0"><i class="fas fa-th-large me-2 text-primary"></i>Sections</h2>
                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addSectionModal">
                    <i class="fas fa-plus me-1"></i> Add section
                </button>
            </div>
            <div class="card-body">
                <p class="text-gray-600 small">
                    Use the arrows to reorder sections. Hidden sections stay published but are removed from the public page.
                </p>

                @if (sections.Any())
                {
                    <ul class="list-group list-group-flush">
                        @for (var i = 0; i < sections.Count; i++)
                        {
                            var sect = sections[i];
                            <li class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="min-w-0">
                                        <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                                            <i class="@sect.IconClass" aria-hidden="true"></i>
                                            <strong>@sect.NameEn</strong>
                                            <span class="text-gray-600" dir="rtl">@sect.NameAr</span>
                                            @if (sect.IsBuiltIn)
                                            {
                                                <span class="badge bg-info">Built-in</span>
                                            }
                                        </div>
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (sect.IsVisible)
                                            {
                                                <span class="badge bg-success">Visible</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Hidden</span>
                                            }
                                            @if (sect.ShowInNavbar)
                                            {
                                                <span class="badge bg-primary">In navbar</span>
                                            }
                                            <span class="badge bg-dark">Order @sect.Order</span>
                                            <code class="small">@sect.Identifier</code>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-column gap-1 flex-shrink-0">
                                        <div class="btn-group btn-group-sm">
                                            <form asp-action="MoveSection" asp-route-id="@sect.Id" asp-route-direction="up" method="post">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move up"
                                                        disabled="@(i == 0)">
                                                    <i class="fas fa-arrow-up"></i>
                                                </button>
                                            </form>
                                            <form asp-action="MoveSection" asp-route-id="@sect.Id" asp-route-direction="down" method="post">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move down"
                                                        disabled="@(i == sections.Count - 1)">
                                                    <i class="fas fa-arrow-down"></i>
                                                </button>
                                            </form>
                                        </div>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-warning btn-sm" title="Edit section"
                                                    data-section-edit="true"
                                                    data-id="@sect.Id"
                                                    data-name-en="@sect.NameEn"
                                                    data-name-ar="@sect.NameAr"
                                                    data-icon="@sect.IconClass"
                                                    data-visible="@sect.IsVisible.ToString().ToLowerInvariant()"
                                                    data-navbar="@sect.ShowInNavbar.ToString().ToLowerInvariant()"
                                                    data-bs-toggle="modal" data-bs-target="#editSectionModal">
                                                <i class="fas fa-pen"></i>
                                            </button>
                                            <form asp-action="ToggleSectionVisibility" asp-route-id="@sect.Id" method="post">
                                                <button type="submit" class="btn btn-outline-info btn-sm" title="Toggle visibility">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            </form>
                                            @if (!sect.IsBuiltIn)
                                            {
                                                <a asp-action="EditCustomSection" asp-route-id="@sect.Id"
                                                   class="btn btn-outline-primary btn-sm" title="Edit custom content">
                                                    <i class="fas fa-file-alt"></i>
                                                </a>
                                                <form asp-action="DeleteSection" asp-route-id="@sect.Id" method="post"
                                                      data-confirm="Delete this section? This cannot be undone.">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete section">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-gray-600 mb-0">No sections have been created yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addSectionModal" tabindex="-1" aria-labelledby="addSectionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddSection" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addSectionModalLabel">Add section</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="sectionNameEn">Name (English)</label>
                        <input id="sectionNameEn" type="text" name="NameEn" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="sectionNameAr">Name (Arabic)</label>
                        <input id="sectionNameAr" type="text" name="NameAr" class="form-control" dir="rtl" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="sectionIdentifier">Identifier</label>
                        <input id="sectionIdentifier" type="text" name="Identifier" class="form-control"
                               pattern="[a-z0-9-]+" required />
                        <span class="input-hint">Lowercase letters, numbers and hyphens only.</span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="sectionIcon">Icon class</label>
                        <input id="sectionIcon" type="text" name="IconClass" class="form-control" value="fas fa-section" />
                        <span class="input-hint">Font Awesome class, for example <code>fas fa-star</code>.</span>
                    </div>
                    <div class="form-check mb-2">
                        <input id="sectionVisible" type="checkbox" name="IsVisible" value="true" class="form-check-input" checked />
                        <label class="form-check-label" for="sectionVisible">Visible</label>
                    </div>
                    <div class="form-check">
                        <input id="sectionNavbar" type="checkbox" name="ShowInNavbar" value="true" class="form-check-input" checked />
                        <label class="form-check-label" for="sectionNavbar">Show in navbar</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add section</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editSectionModal" tabindex="-1" aria-labelledby="editSectionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateSection" method="post">
                <input type="hidden" id="editSectionId" name="id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editSectionModalLabel">Edit section</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="editNameEn">Name (English)</label>
                        <input id="editNameEn" type="text" name="nameEn" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editNameAr">Name (Arabic)</label>
                        <input id="editNameAr" type="text" name="nameAr" class="form-control" dir="rtl" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editIconClass">Icon class</label>
                        <input id="editIconClass" type="text" name="iconClass" class="form-control" />
                    </div>
                    <div class="form-check mb-2">
                        <input id="editIsVisible" type="checkbox" name="isVisible" value="true" class="form-check-input" />
                        <label class="form-check-label" for="editIsVisible">Visible</label>
                    </div>
                    <div class="form-check">
                        <input id="editShowInNavbar" type="checkbox" name="showInNavbar" value="true" class="form-check-input" />
                        <label class="form-check-label" for="editShowInNavbar">Show in navbar</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-section-edit]').forEach(function (button) {
            button.addEventListener('click', function () {
                document.getElementById('editSectionId').value = button.dataset.id || '';
                document.getElementById('editNameEn').value = button.dataset.nameEn || '';
                document.getElementById('editNameAr').value = button.dataset.nameAr || '';
                document.getElementById('editIconClass').value = button.dataset.icon || '';
                document.getElementById('editIsVisible').checked = button.dataset.visible === 'true';
                document.getElementById('editShowInNavbar').checked = button.dataset.navbar === 'true';
            });
        });
    </script>
}

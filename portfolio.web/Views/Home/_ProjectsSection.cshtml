@model Portfolio.Core.DTOs.HomeViewModel
@{
    var lang = Model.CurrentLanguage;
    var categories = ViewBag.Categories as List<Portfolio.Core.Entities.ProjectCategory>;
}

<div class="container">
    <h2 class="section-title">@(lang == "en" ? "Projects" : "المشاريع")</h2>

    <div class="filter-buttons text-center mb-5">
        <button class="filter-btn active" data-filter="all">
            <i class="fas fa-th"></i> @(lang == "en" ? "All" : "الكل")
        </button>
        @if (categories != null)
        {
            @foreach (var category in categories)
            {
                <button class="filter-btn" data-filter="@category.Slug">
                    <i class="@category.IconClass"></i> @(lang == "en" ? category.NameEn : category.NameAr)
                </button>
            }
        }
    </div>

    <!-- Rest of the projects grid -->
    <div class="row g-4" id="projectsGrid">
        @foreach (var project in Model.Projects)
        {
            <div class="col-md-4 project-item @(project.IsHidden ? "hidden-project" : "")"
                 data-category="@project.Category"
                 style="display: @(project.IsHidden ? "none" : "block")">
                <div class="project-card" onclick="trackProjectClick(@project.Id, '@project.GithubUrl')">
                    <div class="project-image">
                        @if (!string.IsNullOrEmpty(project.ImagePath))
                        {
                            <img src="@project.ImagePath" alt="@project.TitleEn" />
                        }
                        else
                        {
                            <i class="@project.IconClass"></i>
                        }
                    </div>
                    <div class="project-content">
                        <h3 class="project-title">@(lang == "en" ? project.TitleEn : project.TitleAr)</h3>
                        <p class="project-desc">@(lang == "en" ? project.ShortDescriptionEn : project.ShortDescriptionAr)</p>
                        <div>
                            @foreach (var tech in project.Technologies)
                            {
                                <span class="tech-tag">@tech.TechnologyName</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Projects.Any(p => p.IsHidden))
    {
        <div class="text-center mt-5">
            <button class="btn btn-custom" id="showMoreBtn" onclick="toggleProjects()">
                <span id="showMoreText">@(lang == "en" ? "Show More Projects" : "عرض المزيد من المشاريع")</span>
                <i class="fas fa-chevron-down ms-2" id="showMoreIcon"></i>
            </button>
        </div>
    }
</div>
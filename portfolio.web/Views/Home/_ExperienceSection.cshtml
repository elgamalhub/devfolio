@model Portfolio.Core.DTOs.HomeViewModel
@{
    var lang = Model.CurrentLanguage;
}

<div class="container">
    <h2 class="section-title">@(lang == "en" ? "Experience" : "الخبرات")</h2>
    <p class="section-subtitle">@(lang == "en" ? "A journey through the teams, programs, and projects that shaped my craft." : "رحلة عبر الفرق والبرامج والمشاريع التي صقلت خبرتي.")</p>

    <div class="timeline">
        @foreach (var exp in Model.Experiences)
        {
            <article class="timeline-item">
                <div class="timeline-content">
                    <span class="timeline-date">
                        <i class="fas fa-calendar-alt me-1" aria-hidden="true"></i>
                        @exp.StartDate.ToString("MMM yyyy") —
                        @(exp.IsCurrent ? (lang == "en" ? "Present" : "الآن") : exp.EndDate?.ToString("MMM yyyy"))
                    </span>
                    <h3>@(lang == "en" ? exp.TitleEn : exp.TitleAr)</h3>
                    <h4>@(lang == "en" ? exp.CompanyEn : exp.CompanyAr)</h4>
                    <p>@(lang == "en" ? exp.DescriptionEn : exp.DescriptionAr)</p>
                </div>
            </article>
        }
    </div>
</div>

@model Portfolio.Core.DTOs.HomeViewModel
@{
    var lang = Model.CurrentLanguage;
}

<div class="container">
    <h2 class="section-title">@(lang == "en" ? "About Me" : "عني")</h2>
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="about-card">
                @if (!string.IsNullOrEmpty(Model.About?.ProfileImage))
                {
                    <div class="text-center mb-4">
                        <img src="@Model.About.ProfileImage" alt="@Model.About.NameEn"
                             class="rounded-circle" style="width: 200px; height: 200px; object-fit: cover; border: 5px solid var(--primary-color);">
                    </div>
                }
                <p class="lead">@(lang == "en" ? Model.About?.DescriptionEn : Model.About?.DescriptionAr)</p>

                @if (Model.SocialLinks.Any())
                {
                    <div class="social-links mt-4 text-center">
                        @foreach (var link in Model.SocialLinks)
                        {
                            <a href="@link.Url" target="_blank" class="social-icon" title="@link.Platform">
                                <i class="@link.IconClass"></i>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@model Portfolio.Core.DTOs.HomeViewModel
@{
    var lang = Model.CurrentLanguage;
    var skills = Model.Skills.ToList();
    var half = (int)Math.Ceiling(skills.Count / 2.0);
}

<div class="container">
    <h2 class="section-title">@(lang == "en" ? "Skills & Technologies" : "المهارات والتقنيات")</h2>
    <p class="section-subtitle">@(lang == "en" ? "The tools I use to design, build, and ship reliable software." : "الأدوات التي أستخدمها لتصميم وبناء وتسليم برمجيات موثوقة.")</p>

    <div class="row g-lg-5">
        <div class="col-md-6">
            @for (var i = 0; i < half; i++)
            {
                var skill = skills[i];
                <div class="skill-item">
                    <div class="skill-head">
                        <span class="skill-name">@(lang == "en" ? skill.NameEn : skill.NameAr)</span>
                        <span class="skill-percent">@skill.Percentage%</span>
                    </div>
                    <div class="progress" role="progressbar" aria-label="@(lang == "en" ? skill.NameEn : skill.NameAr)"
                         aria-valuenow="@skill.Percentage" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: 0" data-width="@skill.Percentage%"></div>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-6">
            @for (var i = half; i < skills.Count; i++)
            {
                var skill = skills[i];
                <div class="skill-item">
                    <div class="skill-head">
                        <span class="skill-name">@(lang == "en" ? skill.NameEn : skill.NameAr)</span>
                        <span class="skill-percent">@skill.Percentage%</span>
                    </div>
                    <div class="progress" role="progressbar" aria-label="@(lang == "en" ? skill.NameEn : skill.NameAr)"
                         aria-valuenow="@skill.Percentage" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: 0" data-width="@skill.Percentage%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

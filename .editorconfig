root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,cshtml,razor}]
indent_size = 4
max_line_length = 160

[*.{json,yml,yaml}]
indent_size = 2

[*.{css,scss,js,ts}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets}]
indent_size = 2

@model Portfolio.Core.DTOs.HomeViewModel
@{
    var lang = Model.CurrentLanguage;
    ViewBag.Language = lang;
    var categories = ViewBag.Categories as List<Portfolio.Core.Entities.ProjectCategory>;
}

<div class="container">
    <h2 class="section-title">@(lang == "en" ? "Selected Projects" : "مختارات من المشاريع")</h2>
    <p class="section-subtitle">@(lang == "en" ? "Real applications built with .NET, SQL Server, and modern front-end tooling." : "تطبيقات حقيقية مبنية باستخدام .NET وSQL Server وأدوات واجهة حديثة.")</p>

    @if (categories != null && categories.Any())
    {
        <div class="filter-buttons" role="group" aria-label="@(lang == "en" ? "Filter projects" : "تصفية المشاريع")">
            <button type="button" class="filter-btn active" data-filter="all">
                <i class="fas fa-layer-group me-1" aria-hidden="true"></i>
                @(lang == "en" ? "All" : "الكل")
            </button>
            @foreach (var category in categories)
            {
                <button type="button" class="filter-btn" data-filter="@category.Slug">
                    <i class="@category.IconClass me-1" aria-hidden="true"></i>
                    @(lang == "en" ? category.NameEn : category.NameAr)
                </button>
            }
        </div>
    }

    <div class="row g-4" id="projectsGrid">
        @foreach (var project in Model.Projects)
        {
            @await Html.PartialAsync("_ProjectCard", project)
        }
    </div>

    @if (Model.Projects.Any(p => p.IsHidden))
    {
        <div class="text-center mt-5">
            <button type="button" class="btn btn-custom-outline" id="showMoreBtn">
                <span id="showMoreText">@(lang == "en" ? "Show more projects" : "عرض المزيد من المشاريع")</span>
                <i class="fas fa-chevron-down ms-2" id="showMoreIcon" aria-hidden="true"></i>
            </button>
        </div>
    }
</div>

@model Portfolio.Core.DTOs.HomeViewModel
@{
    var lang = Model.CurrentLanguage;
    var recentPosts = ViewBag.RecentPosts as List<Portfolio.Core.Entities.BlogPost>;
}

@if (recentPosts != null && recentPosts.Any())
{
    <div class="container">
        <h2 class="section-title">@(lang == "en" ? "Latest from Blog" : "أحدث المقالات")</h2>
        <p class="text-center text-muted mb-5">@(lang == "en" ? "Check out my recent thoughts and tutorials" : "تحقق من أفكاري ودروسي الأخيرة")</p>

        <div class="row g-4">
            @foreach (var post in recentPosts.Take(3))
            {
                <div class="col-md-4">
                    <div class="blog-preview-card">
                        @if (!string.IsNullOrEmpty(post.FeaturedImage))
                        {
                            <div class="blog-preview-image" style="background-image: url('@post.FeaturedImage');"></div>
                        }
                        else
                        {
                            <div class="blog-preview-image" style="background: linear-gradient(135deg, #667eea, #764ba2);"></div>
                        }

                        <div class="blog-preview-content">
                            <div class="blog-preview-meta">
                                <span><i class="fas fa-calendar"></i> @post.PublishedAt.ToString("MMM dd, yyyy")</span>
                                <span><i class="fas fa-eye"></i> @post.ViewCount</span>
                            </div>

                            <h4 class="blog-preview-title">@(lang == "en" ? post.TitleEn : post.TitleAr)</h4>

                            <p class="blog-preview-excerpt">
                                @{
                                    var content = lang == "en" ? post.ContentEn : post.ContentAr;
                                    var excerpt = System.Text.RegularExpressions.Regex.Replace(content, "<.*?>", "");
                                    excerpt = excerpt.Length > 100 ? excerpt.Substring(0, 100) + "..." : excerpt;
                                }
                                @excerpt
                            </p>

                            <div class="blog-preview-tags mb-3">
                                @foreach (var tag in post.Tags.Take(2))
                                {
                                    <span class="blog-tag">@tag.TagName</span>
                                }
                            </div>

                            <a href="@Url.Action("Post", "Blog", new { slug = post.Slug, lang })" class="btn btn-custom btn-sm">
                                @(lang == "en" ? "Read More" : "اقرأ المزيد") <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a href="@Url.Action("Index", "Blog", new { lang })" class="btn btn-custom-outline btn-lg">
                <i class="fas fa-blog me-2"></i> @(lang == "en" ? "View All Posts" : "عرض جميع المقالات")
            </a>
        </div>
    </div>
}

<style>
    .blog-preview-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
    }

        .blog-preview-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        }

    .blog-preview-image {
        height: 200px;
        background-size: cover;
        background-position: center;
    }

    .blog-preview-content {
        padding: 25px;
    }

    .blog-preview-meta {
        display: flex;
        gap: 15px;
        color: #999;
        font-size: 0.85rem;
        margin-bottom: 15px;
    }

        .blog-preview-meta span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

    .blog-preview-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: #333;
        margin-bottom: 15px;
        line-height: 1.4;
    }

    .blog-preview-excerpt {
        color: #666;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 15px;
    }

    .blog-tag {
        display: inline-block;
        background: #f0f0f0;
        padding: 5px 12px;
        border-radius: 15px;
        font-size: 0.8rem;
        color: #667eea;
        margin-right: 8px;
    }

    body.light-mode .blog-preview-card {
        background: white;
    }

    body.light-mode .blog-preview-title {
        color: #333;
    }

    body.light-mode .blog-preview-excerpt {
        color: #666;
    }
</style>
@model Portfolio.Core.Entities.Project
@{
    ViewData["Title"] = "Delete Project";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Delete Project</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card shadow mb-4 border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Confirm Delete</h5>
        </div>
        <div class="card-body">
            <p class="lead">Are you sure you want to delete this project?</p>

            <div class="alert alert-warning" role="alert">
                <i class="fas fa-exclamation-circle"></i> This action cannot be undone!
            </div>

            <dl class="row">
                <dt class="col-sm-3">Title (EN)</dt>
                <dd class="col-sm-9">@Model.TitleEn</dd>

                <dt class="col-sm-3">Title (AR)</dt>
                <dd class="col-sm-9" dir="rtl">@Model.TitleAr</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">
                    <span class="badge badge-info">@Model.Category</span>
                </dd>

                <dt class="col-sm-3">Technologies</dt>
                <dd class="col-sm-9">
                    @foreach (var tech in Model.Technologies)
                    {
                        <span class="badge badge-secondary">@tech.TechnologyName</span>
                    }
                </dd>
            </dl>

            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="mb-3">
                    <img src="@Model.ImagePath" alt="@Model.TitleEn" class="img-thumbnail" style="max-width: 200px;" />
                </div>
            }

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete Project
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
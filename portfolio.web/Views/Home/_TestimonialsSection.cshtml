@model Portfolio.Core.DTOs.HomeViewModel
@{
    var lang = Model.CurrentLanguage;
    var joinLabel = lang == "en" ? "at" : "في";
}

<div class="container">
    <h2 class="section-title">@(lang == "en" ? "Testimonials" : "آراء العملاء")</h2>
    <p class="section-subtitle">@(lang == "en" ? "What teammates and clients say about working together." : "ما يقوله زملاء العمل والعملاء عن التجربة المشتركة.")</p>

    <div class="row g-4">
        @foreach (var testimonial in Model.Testimonials)
        {
            <div class="col-md-6 col-lg-4">
                <article class="testimonial-card">
                    <i class="fas fa-quote-right testimonial-quote" aria-hidden="true"></i>

                    <div class="testimonial-rating" aria-label="@testimonial.Rating / 5">
                        @for (var i = 0; i < testimonial.Rating; i++)
                        {
                            <i class="fas fa-star" aria-hidden="true"></i>
                        }
                        @for (var i = testimonial.Rating; i < 5; i++)
                        {
                            <i class="far fa-star" aria-hidden="true"></i>
                        }
                    </div>

                    <p class="testimonial-text">
                        “@(lang == "en" ? testimonial.TestimonialTextEn : testimonial.TestimonialTextAr)”
                    </p>

                    <div class="testimonial-author">
                        @if (!string.IsNullOrWhiteSpace(testimonial.ClientImage))
                        {
                            <img src="@testimonial.ClientImage" alt="@testimonial.ClientName" class="author-image" loading="lazy" width="52" height="52" />
                        }
                        else
                        {
                            <div class="author-image-placeholder">
                                <i class="fas fa-user" aria-hidden="true"></i>
                            </div>
                        }

                        <div class="author-info">
                            <h5 class="author-name">@testimonial.ClientName</h5>
                            <p class="author-position">
                                @testimonial.Position
                                @if (!string.IsNullOrWhiteSpace(testimonial.Company))
                                {
                                    <span>@joinLabel @testimonial.Company</span>
                                }
                            </p>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
</div>

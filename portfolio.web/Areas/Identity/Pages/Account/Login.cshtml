@page
@model portfolio.web.Areas.Identity.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Admin sign in";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#4e54c8" />
    <title>@ViewData["Title"] - Portfolio Admin</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <link href="~/css/login.css" rel="stylesheet" />
</head>
<body>
    <div class="login-page">
        <aside class="login-aside" aria-hidden="true">
            <div class="login-brand">
                <span class="login-brand-icon"><i class="fas fa-user-shield"></i></span>
                <span>Portfolio Admin</span>
            </div>

            <div class="login-copy">
                <h1>Manage your portfolio with confidence.</h1>
                <p>Update projects, articles, experience and site settings from one secure dashboard.</p>
                <ul class="login-points">
                    <li><i class="fas fa-check"></i> Secure administrator access</li>
                    <li><i class="fas fa-check"></i> Live bilingual content</li>
                    <li><i class="fas fa-check"></i> Uploads and analytics in one place</li>
                </ul>
            </div>

            <div class="login-aside-footer">
                &copy; @DateTime.Now.Year Portfolio Admin
            </div>
        </aside>

        <main class="login-main">
            <div class="login-card">
                <div class="login-card-header">
                    <span class="login-eyebrow">Administrator</span>
                    <h2>Sign in</h2>
                    <p>Use your administrator account to continue.</p>
                </div>

                <form id="account" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email address</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username"
                               inputmode="email" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" type="password" class="form-control"
                               autocomplete="current-password" placeholder="Enter your password" />
                        <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label" asp-for="Input.RememberMe">Remember me on this device</label>
                    </div>

                    <button id="login-submit" type="submit" class="btn btn-login">
                        <i class="fas fa-sign-in-alt" aria-hidden="true"></i>
                        Sign in
                    </button>

                    <p class="login-note">
                        This area is restricted to the site owner. If you reached this page by mistake,
                        you can return to the public site below.
                    </p>
                    <div class="text-center">
                        <a class="login-home" href="@Url.Action("Index", "Home", new { area = "" })">
                            <i class="fas fa-arrow-left" aria-hidden="true"></i>
                            Back to portfolio
                        </a>
                    </div>
                </form>
            </div>
        </main>
    </div>
</body>
</html>
